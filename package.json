{
    "name":  "huangquan-agent",
    "version":  "0.3.0",
    "description":  "榛勬硥Agent - 妗岄潰绾?AI 鍔╂墜",
    "main":  "dist-electron/main.js",
    "scripts":  {
                    "dev":  "node scripts/check-theme-tokens.mjs \u0026\u0026 vite build \u0026\u0026 tsc -p electron/tsconfig.json \u0026\u0026 concurrently -k \"vite build --watch\" \"electron .\"",
                    "build":  "node scripts/check-theme-tokens.mjs \u0026\u0026 vite build \u0026\u0026 tsc -p electron/tsconfig.json",
                    "preview":  "vite preview",
                    "start":  "electron .",
                    "package:win":  "npm run build \u0026\u0026 electron-builder --win --config electron-builder.yml",
                    "package:mac":  "npm run build \u0026\u0026 electron-builder --mac --config electron-builder.yml",
                    "package:linux":  "npm run build \u0026\u0026 electron-builder --linux --config electron-builder.yml",
                    "test":  "vitest run"
                },
    "dependencies":  {
                         "lucide-react":  "^1.28.0",
                         "playwright-core":  "^1.62.1",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "react-icons":  "^5.3.0",
                         "react-markdown":  "^9.0.1",
                         "rehype-highlight":  "^7.0.0",
                         "remark-gfm":  "^4.0.0",
                         "uuid":  "^10.0.0",
                         "zustand":  "^4.5.5"
                     },
    "devDependencies":  {
                            "@types/react":  "^18.3.0",
                            "@types/react-dom":  "^18.3.0",
                            "@types/uuid":  "^10.0.0",
                            "@vitejs/plugin-react":  "^4.3.0",
                            "concurrently":  "^9.0.0",
                            "electron":  "^32.0.0",
                            "electron-builder":  "^25.0.0",
