{
  "name": "huangquan-agent",
  "productName": "黄泉Agent",
  "version": "0.4.0",
  "description": "黄泉Agent - 桌面级 AI 助手",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/check-theme-tokens.mjs && vite build && tsc -p electron/tsconfig.json && concurrently -k \"vite build --watch\" \"electron .\"",
    "build": "node scripts/check-theme-tokens.mjs && tsc -p tsconfig.json --noEmit && vite build && tsc -p electron/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json",
    "lint": "eslint src electron",
    "preview": "vite preview",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "test": "vitest run",
    "eval:unit": "tsx scripts/eval/benchmark.ts unit",
    "eval:live": "tsx scripts/eval/benchmark.ts live",
    "brand:scan": "node scripts/eval/brand-scan.mjs",
    "release:check": "node scripts/eval/release-check.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.3",
    "playwright-core": "^1.62.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "ws": "^8.21.3",
    "zustand": "^4.5.5"
  }
}
