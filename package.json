{
  "name": "huangquan-agent",
  "version": "0.2.0",
  "description": "黄泉Agent - 桌面级 AI 助手",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite build && tsc -p electron/tsconfig.json && concurrently -k \"vite --watch\" \"electron .\"",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "rehype-highlight": "^7.0.0",
    "uuid": "^10.0.0",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0"
  }
}
